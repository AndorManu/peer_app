# Peer — credentials template.
# Copy this file to `.env` (which is git-ignored) and fill in values as we collect them.
# Blank ones = Fable will ask you for them at the milestone that needs them.
# RULE: SERVICE_ROLE / SECRET / APP_SECRET keys are server-side ONLY — never expose them in the browser.

# ── 1. AI — needed first (the tutor itself) ──
# claude-haiku-4-5 is fast/cheap for the free tier; claude-sonnet-4-6 for Pro.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# (Legacy fallback — current app also supports OpenAI. Leave blank if using Anthropic.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=5173

# ── 2. Supabase — needed first (backend: DB, auth, storage) ──
# URL + ANON are safe for the browser; SERVICE_ROLE is secret (server only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── 3. Google sign-in (M4) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 4. Facebook sign-in (M4) ──
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── 5. Stripe payments (M5) ──
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_WEBHOOK_SECRET=

# ── 6. Image generation (M7) — pick a provider later ──
IMAGE_API_KEY=

# ── 6b. RAG embeddings (M8) — Voyage preferred; falls back to OPENAI_API_KEY ──
VOYAGE_API_KEY=

# ── 6c. Security (production) — comma-separated extra allowed origins for /api ──
# PEER_ALLOWED_ORIGINS=https://your-production-domain.com

# ── 7. Voice (M6) — OPTIONAL. Browser Web Speech API is free & needs no key.
# ELEVENLABS_API_KEY=

# ── 8. Hosting (optional, M1/M13) ──
# VERCEL_TOKEN=
